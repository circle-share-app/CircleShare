# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/circleshare?schema=public"

# Blockchain Configuration
# IMPORTANT: Replace these values with your actual contract addresses and RPC endpoint
BLOCKCHAIN_NETWORK=mainnet
RPC_URL=https://your-rpc-endpoint-here
RPC_FALLBACK_URL=https://your-fallback-rpc-here

# CircleFactory Contract
CIRCLE_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
CIRCLE_FACTORY_DEPLOYMENT_BLOCK=0

# Event Listener Configuration
SYNC_BATCH_SIZE=1000
SYNC_INTERVAL_MS=30000
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=5000

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Password Hashing
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# CORS
CORS_ORIGIN=*

# Optional: API Keys for additional services
# ALCHEMY_API_KEY=
# INFURA_API_KEY=
